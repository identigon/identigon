<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Expose representation by returning/accepting mutable objects (e.g. lists/maps). Expected for our builders and records. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    </Match>

    <!-- Minor/acceptable issues for this project. -->
    <Match>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE,URF_UNREAD_FIELD,VA_FORMAT_STRING_USES_NEWLINE,WMI_WRONG_MAP_ITERATOR" />
    </Match>

    <!-- CLI tools intentionally read/write files specified by the user via arguments. -->
    <Match>
        <Bug pattern="PATH_TRAVERSAL_IN" />
    </Match>

    <!-- Test scope exclusions, including the empty "sa" password H2's own in-memory-test convention uses -->
    <Match>
        <Bug pattern="DLS_DEAD_LOCAL_STORE,DM_DEFAULT_ENCODING,DMI_EMPTY_DB_PASSWORD,HARD_CODE_PASSWORD,LG_LOST_LOGGER_DUE_TO_WEAK_REFERENCE" />
    </Match>
</FindBugsFilter>
