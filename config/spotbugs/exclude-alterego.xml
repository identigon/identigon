<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Records expose their fields intentionally (no defensive copying needed) -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Allow constructors that throw exceptions (validation) -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Tests often use rough constants -->
    <Match>
        <Bug pattern="CNT_ROUGH_CONSTANT_VALUE"/>
    </Match>

    <!-- Derivation's Mac prototype is keyed with a fixed, public byte only to pin its provider
         before cloning; every clone is re-keyed before use, so it never protects anything. -->
    <Match>
        <Class name="org.identigon.alterego.Derivation"/>
        <Bug pattern="HARD_CODE_KEY"/>
    </Match>
</FindBugsFilter>
