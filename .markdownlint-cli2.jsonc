{
  // Full default rule set, enabled deliberately rather than left at a narrower starting point.
  // "default" is stated explicitly here rather than left implicit - a reader shouldn't have to
  // know that omission-means-true rule to see the ruleset.
  //
  // MD013: matches the 100-column prose convention in AGENTS.md's Code style section. printWidth
  // in .prettierrc.json MUST match this line_length - change one, change both. Tables and code
  // blocks are exempt because there's no sensible way to "wrap" either without corrupting them,
  // and headings are exempt because a heading is one line by construction. `stern` closes most of
  // the gap non-strict mode leaves open (an ordinary prose line with one long trailing word is
  // otherwise silently forgiven) while still exempting a line that is *purely* one unbreakable
  // token - a bare URL on its own line, most commonly.
  //
  // MD024 (no-duplicate-heading) uses `siblings_only` because CHANGELOG.md legitimately repeats
  // "Added"/"Fixed"/etc. headings once per version entry (Keep a Changelog convention);
  // `siblings_only` only flags duplicates within the same parent section, not document-wide.
  "config": {
    "default": true,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false,
      "stern": true
    },
    "MD024": {
      "siblings_only": true
    }
  }
}
